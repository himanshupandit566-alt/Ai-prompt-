# FX Prompty - Firebase Authentication & Firestore Configuration
# Rename this file to .env and insert your real Firebase credentials from the Firebase Console

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=fx-prompty.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fx-prompty
VITE_FIREBASE_STORAGE_BUCKET=fx-prompty.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
